# Single-page app routing for Apache / Hostinger.
# Real files (images, send-form.php, sitemap.xml…) are served as-is;
# every other URL is handed to index.html and React Router picks the page.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # pages with a pre-built HTML file (about.html, blog.html…) are served for /about, /blog…
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]
  RewriteRule ^ index.html [L]
</IfModule>
